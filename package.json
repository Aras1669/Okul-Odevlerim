{
  "name": "okul-odevlerim",
  "version": "1.0.0",
  "private": true,
  "description": "Okul Ödevlerim - Google Classroom alternatifi (TÜBİTAK araştırma projesi)",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init": "wrangler d1 execute okul-odevlerim-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute okul-odevlerim-db --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy public --project-name=okul-odevlerim"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
